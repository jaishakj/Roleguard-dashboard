rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Identity lookup - cached across calls in same request
    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jaishak2003@gmail.com' ||
        getUserData(request.auth.uid).role == 'admin'
      );
    }
    
    function isEditor() {
      return isSignedIn() && (isAdmin() || getUserData(request.auth.uid).role == 'editor');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt', 'displayName']) &&
             data.keys().size() == 4 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'editor', 'viewer'] &&
             data.createdAt == (resource == null ? request.time : existing().createdAt) &&
             data.displayName is string && data.displayName.size() <= 100;
    }

    function isValidRecord(data) {
      return data.keys().hasAll(['userId', 'title', 'content', 'createdAt', 'updatedAt']) &&
             data.keys().size() == 5 &&
             data.userId == (resource == null ? request.auth.uid : existing().userId) &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.createdAt == (resource == null ? request.time : existing().createdAt) &&
             data.updatedAt == request.time;
    }

    // --- Collection Rules ---

    match /users/{userId} {
      // List/Get
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Create
      allow create: if isOwner(userId) && 
                    isValidId(userId) && 
                    isValidUser(incoming()) && 
                    (incoming().role == 'viewer' || isAdmin()); // Non-admins can only register as viewers
                    
      // Update
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUser(incoming()) &&
                    (isAdmin() || (
                      // Users can only change displayName
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName'])
                    ));
                    
      // Delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /records/{recordId} {
      // List/Get
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Create
      allow create: if isSignedIn() && 
                    isValidId(recordId) && 
                    isValidRecord(incoming()) &&
                    incoming().userId == request.auth.uid;
      
      // Update
      allow update: if isSignedIn() && (isOwner(existing().userId) || isAdmin()) && 
                    isValidRecord(incoming()) &&
                    (isAdmin() || (isEditor() && isOwner(existing().userId)));
      
      // Delete
      allow delete: if isSignedIn() && (isOwner(existing().userId) || isAdmin());
    }
  }
}
